{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Online Logbook",
  "version": "0.4.0",
  "identifier": "com.bagas.onlinelogbook",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Online Logbook",
        "width": 900,
        "height": 700,
        "minWidth": 640,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRGNDY4REExNDUwMDJEMTIKUldRU0xRQkZvWTFHVDBEK2tDMWhVK1FlQnJkbWZXdlV6dlRDSjhLT0l0d0tPT0lCaHc3Z0FGaisK",
      "endpoints": [
        "https://github.com/BagasCaturS/logBook/releases/latest/download/latest.json"
      ]
    }
  }
}
